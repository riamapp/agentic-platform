# Application Configuration
app_name = "agentic-platform"

# Runtime Version for PROD endpoint
# Update this value when you want to promote a new version to production
# DEV endpoint always uses the latest version automatically
agent_runtime_version = "1"

# Shared Cognito configuration (from agentic-auth Terraform outputs)
#
# After deploying the agentic-auth repo, copy the following values from its
# Terraform outputs into these variables.

# Region where agentic-auth deployed Cognito
aws_region = "eu-west-1"

# From agentic-auth outputs:
#   - user_pool_id
#   - frontend_client_id
#   - m2m_client_id
#   - cognito_domain_url
cognito_user_pool_id       = "eu-west-1_XXXXXXXXX"
cognito_frontend_client_id = "xxxxxxxxxxxxxxxxxxxxxxxxxx"
cognito_m2m_client_id      = "yyyyyyyyyyyyyyyyyyyyyyyyyy"
cognito_domain_url         = "https://agentic-auth-bill.auth.eu-west-1.amazoncognito.com"

# Machine-to-machine client secret for the m2m_client_id above.
# This is NOT output by Terraform; copy it from the Cognito console or
# store it in a secure secret manager and inject via your CI/CD.
cognito_client_secret = "replace-with-m2m-client-secret"

# OAuth scope to request. Must be allowed for the m2m client in agentic-auth.
# For a simple setup, "openid" is sufficient.
cognito_scope = "openid"

